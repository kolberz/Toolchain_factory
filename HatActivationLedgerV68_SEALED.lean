import Mathlib.Tactic

open scoped BigOperators

namespace HatV68Sealed

structure Group where
  r : Nat
  f : Nat
  sumUpper : ℚ
  deriving Repr

def activationWeight (r f : Nat) : ℚ :=
  ∑ j in Finset.range 240,
    if h₁ : r ≤ j then
      let q := j - r
      let top := 1599 - r - f
      if h₂ : q ≤ top then
        (Nat.choose top q : ℚ) / ((1600 : ℚ) * Nat.choose 1599 j)
      else 0
    else 0

def contribution (g : Group) : ℚ :=
  g.sumUpper * activationWeight g.r g.f / 3025

def ledgerBound (xs : List Group) : ℚ :=
  xs.foldl (fun acc g => acc + contribution g) 0

